{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "webapp/public",
  "functions": {
    "api/map-server.mjs": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "data/planet-cartography/abydos/eventide.json"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/map-server" }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "x-content-type-options", "value": "nosniff" }] }]
}
