{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "webapp/public",
  "functions": {
    "api/map-server.mjs": {
      "maxDuration": 60,
      "includeFiles": "{module.json,data/**,docs/**,scripts/**,templates/**,styles/**,lang/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/map-server" },
    { "source": "/modules/:path*", "destination": "/api/map-server" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "x-content-type-options", "value": "nosniff" }] }]
}
